{
  "name": "KWH-006 - Send WhatsApp Message",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-send",
        "responseMode": "onReceived",
        "options": {}
      },
      "typeOptions": {}
    },
    {
      "id": "get-conversation",
      "name": "Get Conversation",
      "type": "n8n-nodes-base.postgres",
      "parameters": {
        "operation": "get",
        "table": "whatsapp_conversations",
        "filters": "id='{{$json.body.conversation_id}}'",
        "options": {}
      },
      "typeOptions": {}
    },
    {
      "id": "send-message",
      "name": "Send via Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "http://evolution_api:8080/message/sendText/={{$json[\"Get Conversation\"].device_id}}",
        "bodyParameters": {
          "parameters": [
            {"name":"number","value":"={{$json[\"Get Conversation\"].jid}}"},
            {"name":"text","value":"={{$json.body.text}}"}
          ]
        },
        "options": {}
      },
      "typeOptions": {}
    },
    {
      "id": "save-message",
      "name": "Save Message",
      "type": "n8n-nodes-base.postgres",
      "parameters": {
        "operation": "insert",
        "table": "whatsapp_messages",
        "columns": ["device_id","conversation_id","message_id","direction","content","content_type","from_me","timestamp"],
        "values": [
          {"name":"device_id","value":"={{$json[\"Get Conversation\"].device_id}}"},
          {"name":"conversation_id","value":"={{$json.body.conversation_id}}"},
          {"name":"message_id","value":"={{$json[\"Send via Evolution\"].messageId}}"},
          {"name":"direction","value":"out"},
          {"name":"content","value":"={{$json.body.text}}"},
          {"name":"content_type","value":"text"},
          {"name":"from_me","value":true},
          {"name":"timestamp","value":"={{$now()}}"}
        ],
        "options": {}
      },
      "typeOptions": {}
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json[\"Send via Evolution\"]}}",
        "options": {}
      },
      "typeOptions": {}
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node":"Get Conversation","type":"main","index":0}]]
    },
    "Get Conversation": {
      "main": [[{"node":"Send via Evolution","type":"main","index":0}]]
    },
    "Send via Evolution": {
      "main": [[{"node":"Save Message","type":"main","index":0}]]
    },
    "Save Message": {
      "main": [[{"node":"Respond","type":"main","index":0}]]
    }
  }
}