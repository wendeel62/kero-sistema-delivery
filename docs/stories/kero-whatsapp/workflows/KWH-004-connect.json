{
  "name": "KWH-004 - Connect WhatsApp Device",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-connect",
        "responseMode": "onReceived",
        "options": {}
      },
      "typeOptions": {}
    },
    {
      "id": "evolution-api",
      "name": "Evolution API",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "http://evolution_api:8080/instance/connect",
        "bodyParameters": {
          "parameters": [
            {"name": "instanceName","value":"={{$json.body.instance_name}}"}
          ]
        },
        "options": {}
      },
      "typeOptions": {}
    },
    {
      "id": "save-device",
      "name": "Save Device",
      "type": "n8n-nodes-base.postgres",
      "parameters": {
        "operation": "insert",
        "table": "whatsapp_devices",
        "columns": ["tenant_id","device_name","instance_name","state"],
        "values": [
          {"name":"tenant_id","value":"={{$json.body.tenant_id}}"},
          {"name":"device_name","value":"={{$json.body.device_name}}"},
          {"name":"instance_name","value":"={{$json.body.instance_name}}"},
          {"name":"state","value":"connecting"}
        ],
        "options": {}
      },
      "typeOptions": {}
    },
    {
      "id": "get-qr",
      "name": "Get QR Code",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "http://evolution_api:8080/instance/connectionState/={{$json.body.instance_name}}",
        "options": {}
      },
      "typeOptions": {}
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json[\"Evolution API\"]}}",
        "options": {}
      },
      "typeOptions": {}
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node":"Evolution API","type":"main","index":0}]]
    },
    "Evolution API": {
      "main": [[{"node":"Save Device","type":"main","index":0}]]
    },
    "Save Device": {
      "main": [[{"node":"Get QR Code","type":"main","index":0}]]
    },
    "Get QR Code": {
      "main": [[{"node":"Respond","type":"main","index":0}]]
    }
  }
}