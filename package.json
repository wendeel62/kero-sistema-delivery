{
  "name": "kero-delivery",
  "private": true,
  "version": "1.0.0",
  "description": "Kero Delivery - Sistema de gestão e delivery para restaurantes e comercios",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:a11y": "eslint . --rule 'jsx-a11y/alt-text: error'",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test tests/accessibility.test.ts",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "images:convert": "node scripts/convert-images.js",
    "images:optimize": "node scripts/optimize-images.js",
    "images:all": "npm run images:convert && npm run images:optimize",
    "sync:skills:opencode": "node .agents/scripts/sync-skills.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@point-of-sale/receipt-printer-encoder": "^3.0.3",
    "@point-of-sale/webusb-receipt-printer": "^2.0.0",
    "@sentry/react": "^10.53.1",
    "@supabase/supabase-js": "^2.101.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.95.2",
    "axios": "^1.6.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "node-forge": "^1.4.0",
    "qz-tray": "^2.2.6",
    "react": "^19.2.4",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/language-server": "^0.14.29",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "aiox-core": "^5.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "sharp": "^0.34.5",
    "supabase": "^2.98.2",
    "svgo": "^4.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vercel": "^53.1.1",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.4"
  }
}
