const {Client} = require('/tmp/pgclient/node_modules/pg');
async function run() {
  const ports = [5432, 5433, 54, 54321, 54322, 54];
  for (const port of ports) {
    try {
      const c = new Client({host:'postgres',port:port,user:'kero',password:'kero_#pass',database:'kero'});
      await c.connect();
      await c.query('SELECT 1');
      console.log('WORKS: port ' + port);
      await c.end();
      break;
    } catch(e) {
      console.log('FAIL: port ' + port + ' -> ' + e.code);
    }
  }
}
run().catch(e => console.error(e.message));