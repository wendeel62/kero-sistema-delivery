# ============================================
# Kero Delivery - Environment Configuration
# ============================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local with real credentials
# ============================================

# --------------------------------------------
# Supabase (Database, Auth, Storage, Realtime)
# --------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase key (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ACCESS_TOKEN=your-access-token-here

# --------------------------------------------
# AI Providers (Groq / Cloudflare)
# --------------------------------------------
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# --------------------------------------------
# Payments (Mercado Pago OAuth)
# --------------------------------------------
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# --------------------------------------------
# Storage (Cloudflare R2)
# --------------------------------------------
VITE_R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kero-images

# --------------------------------------------
# Push Notifications (VAPID)
# --------------------------------------------
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=your-email@example.com

# --------------------------------------------
# Monitoring (Sentry)
# --------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# --------------------------------------------
# Server / Backend
# --------------------------------------------
PORT=3001
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
WEBHOOK_SECRET=<generate-a-secure-random-string>

# --------------------------------------------
# Deployment
# --------------------------------------------
RAILWAY_TOKEN=
VERCEL_TOKEN=
